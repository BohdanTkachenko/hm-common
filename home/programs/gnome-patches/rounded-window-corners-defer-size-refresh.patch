+ * @param actor - The window actor.
+ */
+function cancelSizeChanged(actor) {
+    const id = pendingSizeChanges.get(actor);
+    if (id === undefined) {
+        return;
+    }
+    global.compositor.get_laters().remove(id);
+    pendingSizeChanges.delete(actor);
+}
