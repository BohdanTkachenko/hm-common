+const pendingSizeChanges = new Map();
+/**
+ * Refresh the effect after a size change, but never synchronously.
+ *
+ * Mutter emits `size-changed` on the window texture while the actor is being
+ * painted, notably from `paint_to_content()` in GNOME Shell's size-change
+ * animation when a window maximizes or goes fullscreen. Refreshing there can
+ * remove the effect mid-paint, and Clutter then aborts the whole shell
+ * (`clutter_actor_node_new: assertion failed: (actor != NULL)`). Run the
+ * refresh before the next redraw instead, at most once per actor and frame.
+ *
+ * @param actor - The window actor whose size changed.
+ */
+function scheduleSizeChanged(actor) {
+    if (pendingSizeChanges.has(actor)) {
+        return;
+    }
+    const id = global.compositor.get_laters().add(Meta.LaterType.BEFORE_REDRAW, () => {
+        pendingSizeChanges.delete(actor);
+        if (actor.metaWindow) {
+            handlers.onSizeChanged(actor);
+        }
+        return GLib.SOURCE_REMOVE;
+    });
+    pendingSizeChanges.set(actor, id);
+}
+/**
+ * Drop a pending size-change refresh for a window actor.
